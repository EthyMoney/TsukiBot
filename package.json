{
  "name": "tsukibot",
  "version": "1.0.0",
  "description": "Discord bot for cryptocurrency prices, charts, coin details, market statistics, personalized tracking tools, and so much more!",
  "main": "main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node main.js",
    "test": "node --test",
    "dev": "node main.js -d",
    "deploy": "node deploy-commands.js",
    "deploy:dev": "node deploy-commands.js --dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthyMoney/TsukiBot.git"
  },
  "keywords": [
    "discord",
    "cryptocurrency",
    "crypto",
    "trading",
    "stocks",
    "bitcoin",
    "ethereum",
    "eth",
    "btc",
    "tsuki",
    "tsukibot"
  ],
  "author": "Logan S. (EthyMoney)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EthyMoney/TsukiBot/issues"
  },
  "homepage": "https://github.com/EthyMoney/TsukiBot#readme",
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.1",
    "@anthropic-ai/sdk": "^1.12.0",
    "ccxt": "4.5.83",
    "chart.js": "^4.6.1",
    "didyoumean": "^1.2.2",
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "fast-average-color-node": "^4.0.0",
    "finnhub": "^2.0.16",
    "jsdom": "^31.0.1",
    "node-schedule": "^2.1.2",
    "pg": "^8.23.1",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.18.1",
    "puppeteer-cluster": "^0.25.0",
    "sharp": "^0.35.5",
    "topgg-autoposter": "^2.0.2"
  },
  "overrides": {
    "fast-average-color-node": {
      "sharp": "^0.35.5"
    },
    "@top-gg/sdk": {
      "undici": "^6.28.0"
    },
    "ccxt": {
      "undici": "^7.30.1"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "puppeteer@25.18.1": true,
    "ccxt@4.5.83": true
  }
}
