{
  "name": "tsukibot",
  "version": "1.0.0",
  "description": "Discord bot for cryptocurrency prices, charts, coin details, market statistics, personalized tracking tools, and so much more!",
  "main": "main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node main.js",
    "test": "node --test",
    "dev": "node main.js -d",
    "deploy": "node deploy-commands.js",
    "deploy:dev": "node deploy-commands.js --dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthyMoney/TsukiBot.git"
  },
  "keywords": [
    "discord",
    "cryptocurrency",
    "crypto",
    "trading",
    "stocks",
    "bitcoin",
    "ethereum",
    "eth",
    "btc",
    "tsuki",
    "tsukibot"
  ],
  "author": "Logan S. (EthyMoney)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EthyMoney/TsukiBot/issues"
  },
  "homepage": "https://github.com/EthyMoney/TsukiBot#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google-cloud/translate": "^10.0.1",
    "ccxt": "^4.5.73",
    "chart.js": "^4.5.1",
    "didyoumean": "^1.2.2",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "fast-average-color-node": "^3.2.0",
    "finnhub": "^2.0.15",
    "jsdom": "^30.0.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.7.0",
    "puppeteer-cluster": "^0.25.0",
    "sharp": "^0.35.3",
    "topgg-autoposter": "^2.0.2",
    "web3": "^4.16.0"
  },
  "overrides": {
    "fast-average-color-node": {
      "sharp": "^0.35.3"
    },
    "@top-gg/sdk": {
      "undici": "^6.28.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "protobufjs@7.6.5": true,
    "ccxt@4.5.73": true,
    "puppeteer@25.7.0": true
  }
}
